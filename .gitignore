# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & Virtual Envs
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Dependencies & Package Managers
node_modules/
frontend/node_modules/

# Build Outputs
dist/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime Database & Generated Incident Snapshots
backend/data/*.db
backend/data/*.sqlite3
backend/data/incidents/*
!backend/data/incidents/.gitkeep
backend/data/faces/*
!backend/data/faces/.gitkeep

# Model Weights (Auto-downloaded by Ultralytics on first run)
*.pt
*.pth
*.onnx

# Environment & Secrets
.env
.env.*
!.env.example

# IDEs & Operating System Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
